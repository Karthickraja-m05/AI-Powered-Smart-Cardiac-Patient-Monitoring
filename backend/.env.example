# ── Application ──
APP_NAME=CardioSense AI
APP_VERSION=1.0.0
DEBUG=false
PYTHON_VERSION=3.10.11

# ── Security & Authentication ──
JWT_SECRET_KEY=cardiosense-production-secret-jwt-key-2024-carebridge
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Cross-Origin Resource Sharing (CORS) ──
CORS_ORIGINS=["*"]

# ── Database ──
DATABASE_URL=sqlite:///./carebridge.db

# ── Storage ──
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ── Clinical Alert Thresholds ──
ALERT_HR_LOW=40
ALERT_HR_HIGH=150
ALERT_SPO2_LOW=90
ALERT_TEMP_HIGH=39.5
ALERT_BP_SYS_HIGH=180
ALERT_BP_SYS_LOW=80
ALERT_BP_DIA_HIGH=120
ALERT_RESP_LOW=8
ALERT_RESP_HIGH=30
